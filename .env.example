# Copie este arquivo para .env.local e preencha os valores.
# NUNCA coloque chaves reais neste arquivo nem no código: o .env.local não vai para o GitHub.

# Endereço público do site (usado em SEO e links)
NEXT_PUBLIC_SITE_URL=https://www.carpiatelie.com.br

# --- Fase 2: Supabase (Project Settings → API Keys) ---
# Sem estas três, o site funciona com os dados fictícios e o login fica desligado.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Chave secreta: só no servidor. Nunca coloque em código nem mande por mensagem.
SUPABASE_SECRET_KEY=

# --- Fase 3: Melhor Envio (Configurações → Permissões de acesso → Gerar novo token) ---
# Sem o token (ou sem o CEP de origem em src/config/loja.ts), o frete é simulado.
MELHOR_ENVIO_TOKEN=
# "producao" usa a conta real; vazio usa o sandbox (testes, sem pagar etiquetas)
MELHOR_ENVIO_AMBIENTE=

# --- Fase 4: pagamento (pagarme ou pagbank) ---
# PAYMENT_PROVIDER=pagarme
